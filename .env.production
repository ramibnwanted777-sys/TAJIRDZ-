# Production build defaults.
#
# Only PUBLIC values belong here — this file is committed. The Convex deployment
# URL is already exposed to every browser that loads the app.
#
# Convex backend (public): without it the app falls back to the local demo mode.
VITE_CONVEX_URL=https://healthy-lobster-28.eu-west-1.convex.cloud

# PostHog (public project key). Leave empty to disable analytics entirely.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
